<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Soal 3.1: Security Category -->
    <record id="module_category_sekolah" model="ir.module.category">
        <field name="name">Sekolah</field>
        <field name="description">Hak akses modul Sekolah</field>
        <field name="sequence">10</field>
    </record>

    <!-- Soal 3.1: dua Security Group -->
    <record id="group_guru_staff" model="res.groups">
        <field name="name">Guru Staff</field>
        <field name="category_id" ref="module_category_sekolah"/>
    </record>

    <record id="group_admin_sekolah" model="res.groups">
        <field name="name">Admin Sekolah</field>
        <field name="category_id" ref="module_category_sekolah"/>
        <!-- Admin mewarisi hak Guru Staff -->
        <field name="implied_ids" eval="[(4, ref('group_guru_staff'))]"/>
    </record>

    <!-- Admin Sekolah: akses semua record Kelas. -->
    <record id="rule_kelas_admin_all" model="ir.rule">
        <field name="name">Kelas: Admin akses semua</field>
        <field name="model_id" ref="model_dev_sekolah_kelas"/>
        <field name="groups" eval="[(4, ref('group_admin_sekolah'))]"/>
        <field name="domain_force">[(1, '=', 1)]</field>
    </record>

    <!-- Soal 3.3 & 3.4: Record Rule untuk group_guru_staff.
         Guru hanya bisa akses record Kelas di mana dia adalah Wali Kelas. -->
    <record id="rule_kelas_guru_wali" model="ir.rule">
        <field name="name">Kelas: Guru hanya lihat kelas walinya</field>
        <field name="model_id" ref="model_dev_sekolah_kelas"/>
        <field name="groups" eval="[(4, ref('group_guru_staff'))]"/>
        <field name="domain_force">[('wali_kelas_id', '=', user.partner_id.id)]</field>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="True"/>
        <field name="perm_create" eval="True"/>
        <field name="perm_unlink" eval="True"/>
    </record>

</odoo>
